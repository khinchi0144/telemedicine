# ===========================================================================
# MediCare — environment template
# Copy to `.env.local` (or `.env`) and fill in the values you need.
# NEVER commit a real .env file. NEVER hardcode secrets in the repository.
# ===========================================================================

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development

# Public base URL of the application (used for OAuth redirects / emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Leave DATABASE_URL empty to run in local mock mode (file backed dev store).
# Example production connection string:
#   postgresql://USER:PASSWORD@HOST:5432/medicare?schema=public
DATABASE_URL=

# ---------------------------------------------------------------------------
# Session / crypto
# ---------------------------------------------------------------------------
# Used to sign session cookies, OTP tickets and CSRF tokens.
# Generate one with:  openssl rand -base64 48
# Minimum 32 characters. Required in production.
SESSION_SECRET=

# Session lifetime in seconds (default: 7 days)
SESSION_MAX_AGE=604800

# ---------------------------------------------------------------------------
# Local development / mock mode
# ---------------------------------------------------------------------------
# When "true" the app runs WITHOUT PostgreSQL using a file backed development
# datastore (see lib/db/memory-store.ts) so the full UI flow can be tested.
# Automatically disabled when NODE_ENV=production.
USE_MOCK_DB=true

# Mock OTP: returns the OTP in the API response and logs a warning banner so
# the flow can be tested without an SMS provider. Never enable in production.
MOCK_OTP_ENABLED=true
# The fixed 6 digit code used in mock mode (development only).
MOCK_OTP_CODE=123456

# ---------------------------------------------------------------------------
# OTP / SMS provider (production)
# ---------------------------------------------------------------------------
# Comma separated list of supported providers: twilio | msg91 | custom
OTP_PROVIDER=twilio
OTP_SENDER_ID=MediCare
# Used by the "custom" provider to POST { to, message } to a gateway URL.
OTP_GATEWAY_URL=
OTP_API_KEY=
# OTP behaviour
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_RESEND_AFTER_SECONDS=30
OTP_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# Document storage (PRIVATE — never public)
# ---------------------------------------------------------------------------
# local  : files written to ./.storage (development)
# s3     : private S3 bucket (requires the AWS_* variables below)
STORAGE_DRIVER=local
# local
STORAGE_LOCAL_DIR=.storage
# s3
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=
AWS_FORCE_PATH_STYLE=false

# Upload limits
MAX_UPLOAD_SIZE_MB=5
ALLOWED_DOCUMENT_MIME_TYPES=application/pdf,image/jpeg,image/png

# ---------------------------------------------------------------------------
# OAuth — Google (optional)
# ---------------------------------------------------------------------------
# When these are missing the "Continue with Google" button stays visible but
# disabled, so the login page never breaks.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Comma separated list of origins allowed to POST to the API (CSRF defence).
# Defaults to NEXT_PUBLIC_APP_URL when empty.
ALLOWED_ORIGINS=
# Rate limiting (in-process limiter — use Redis in multi-instance deployments)

# OTP requests per mobile number per 15 minutes.
RATE_LIMIT_OTP_PER_15MIN=5
# OTP requests per IP per 15 minutes (stops enumeration across numbers).
RATE_LIMIT_OTP_PER_IP_15MIN=30
RATE_LIMIT_LOGIN_PER_15MIN=10
RATE_LIMIT_REGISTER_PER_HOUR=20
RATE_LIMIT_UPLOAD_PER_HOUR=40

# ---------------------------------------------------------------------------
# Email — verification links & password reset
# ---------------------------------------------------------------------------
# When "true" (the default in production) a PATIENT account stays inactive
# until the emailed link is opened. Set to false in development so the local
# signup flow does not depend on a mail provider.
# Doctors and pharmacies are always held for manual review regardless of this.
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600
# Development only: writes the email (and its link) to the server log so it can
# be followed during local testing.
# Leave unset to get this automatically whenever no provider is configured.
# Never enable in production.
EMAIL_LOG_ENABLED=true

# Transactional email provider (production). Any HTTP provider works — point
# EMAIL_API_URL at its send endpoint.
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_API_URL=

# ---------------------------------------------------------------------------
# Seed demo data (development only)
# ---------------------------------------------------------------------------
# Creates demo@medicare.dev / 9876543210 accounts for each role.
SEED_DEMO_DATA=true
