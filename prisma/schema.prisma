// ---------------------------------------------------------------------------
// MediCare — Prisma schema
// PostgreSQL-ready. Models are designed so later phases (appointments,
// consultations, prescriptions, pharmacy orders, payments) can be added as new
// models without touching the auth / registration layer.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Role of an account. An account has exactly one role.
enum Role {
  PATIENT
  DOCTOR
  PHARMACY
  ADMIN
}

/// Lifecycle status of the account itself.
enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION
  REJECTED
  SUSPENDED
  DELETED
}

/// Verification status used for professional accounts (doctor / pharmacy).
enum VerificationStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum ConsultationMode {
  ONLINE
  OFFLINE
  BOTH
}

enum PharmacyType {
  RETAIL
  WHOLESALE
  RETAIL_WHOLESALE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

/// Documents uploaded during registration. Types are shared between doctors
/// and pharmacies; permissions are enforced server side (a doctor can never
/// upload a GST certificate and vice versa).
enum DocumentType {
  MEDICAL_REGISTRATION_CERTIFICATE
  QUALIFICATION_CERTIFICATE
  IDENTITY_PROOF
  PROFILE_PHOTO
  DRUG_LICENSE
  GST_CERTIFICATE
  PHARMACY_REGISTRATION_CERTIFICATE
  PHARMACY_SHOP_PHOTO
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Purpose an OTP challenge was created for.
enum OtpPurpose {
  REGISTRATION
  LOGIN
  RESET_PASSWORD
}

enum LinkedAccountProvider {
  GOOGLE
}

/// Lifecycle of a patient-booked consultation slot.
enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

/// Lifecycle of a pharmacy order placed by a patient.
enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

/// Lifecycle of a prescription written by a doctor.
enum PrescriptionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

/// Category of a patient-uploaded medical record.
enum MedicalRecordType {
  PRESCRIPTION
  LAB_REPORT
  IMAGING
  DISCHARGE_SUMMARY
  VACCINATION
  OTHER
}

/// Dispensing unit of a stocked medicine.
enum MedicineUnit {
  TABLET
  CAPSULE
  SYRUP
  INJECTION
  DROPS
  OINTMENT
  POWDER
  OTHER
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id               String     @id @default(cuid())
  role             Role
  email            String?    @unique
  mobile           String     @unique
  /// Never plain text. Null for accounts that only use a linked OAuth
  /// provider and have not set a password yet.
  passwordHash     String?
  status           UserStatus @default(ACTIVE)
  isEmailVerified  Boolean    @default(false)
  isMobileVerified Boolean    @default(false)
  lastLoginAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientProfile  PatientProfile?
  doctorProfile   DoctorProfile?
  pharmacyProfile PharmacyProfile?
  linkedAccount   LinkedAccount?
  documents       Document[]
  otpChallenges   OtpChallenge[]
  emailTokens     EmailVerificationToken[]
  passwordTokens  PasswordResetToken[]

  /// Consultations booked by this account as a patient.
  patientAppointments Appointment[] @relation("PatientAppointments")
  /// Consultations assigned to this account as a doctor.
  doctorAppointments Appointment[] @relation("DoctorAppointments")
  /// Prescriptions received (patient) and written (doctor).
  prescriptionsReceived Prescription[] @relation("PatientPrescriptions")
  prescriptionsIssued    Prescription[] @relation("DoctorPrescriptions")
  /// Patient–doctor message threads, seen from either side.
  conversationsAsPatient Conversation[] @relation("PatientConversations")
  conversationsAsDoctor  Conversation[] @relation("DoctorConversations")
  messagesSent Message[] @relation("SentMessages")
  /// Files/records the patient uploaded for their own care.
  medicalRecords MedicalRecord[]
  /// Medicine orders placed by this account as a patient.
  ordersAsPatient PharmacyOrder[] @relation("PatientOrders")
  /// Medicine orders this pharmacy fulfils.
  ordersAsPharmacy PharmacyOrder[] @relation("PharmacyOrders")
  /// Medicines this pharmacy stocks.
  inventoryItems MedicineInventory[]

  @@index([role, status])
  @@index([status])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Account tokens (email verification / password reset)
// ---------------------------------------------------------------------------

/// Single use, hashed email verification tokens.
///
/// Only the SHA-256 hash is stored — the raw token exists solely inside the
/// emailed link. Consumed tokens are deleted immediately.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  /// SHA-256 hash of the raw token.
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

/// Single use, hashed password reset tokens.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  /// SHA-256 hash of the raw token.
  tokenHash String   @unique
  expiresAt DateTime
  /// Set the moment the password is changed, so the link cannot be replayed.
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// OAuth identity linked to a user account (optional — Google in phase 1).
model LinkedAccount {
  id                String                @id @default(cuid())
  userId            String                @unique
  provider          LinkedAccountProvider
  providerAccountId String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("linked_accounts")
}

/// Short lived OTP challenges. The code is stored as a salted hash with an
/// expiry and deleted as soon as it is consumed — OTPs are never persisted.
model OtpChallenge {
  id             String     @id @default(cuid())
  userId         String?
  mobile         String
  purpose        OtpPurpose
  /// Salted SHA-256 hash of the OTP.
  codeHash       String
  salt           String
  attempts       Int        @default(0)
  maxAttempts    Int        @default(5)
  /// Registration ticket this challenge belongs to (purpose = REGISTRATION).
  registrationId String?
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mobile, purpose])
  @@index([expiresAt])
  @@map("otp_challenges")
}

// ---------------------------------------------------------------------------
// Role profiles
// ---------------------------------------------------------------------------

model PatientProfile {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  fullName               String
  dateOfBirth            DateTime?
  gender                 Gender?
  address                String?
  city                   String?
  state                  String?
  pincode                String?
  emergencyContactName   String?
  emergencyContactNumber String?
  // Optional health information — never required to register.
  bloodGroup             String?
  existingConditions     String?
  allergies              String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([city, state])
  @@map("patient_profiles")
}

model DoctorProfile {
  id                        String             @id @default(cuid())
  userId                    String             @unique
  fullName                  String
  medicalRegistrationNumber String
  medicalCouncil            String
  specialization            String
  qualification             String
  experienceYears           Int
  /// Storage key of the profile photo inside the PRIVATE document storage.
  profilePhoto              String?
  clinicName                String
  clinicAddress             String
  city                      String
  state                     String
  pincode                   String
  consultationMode          ConsultationMode
  /// Fee charged per consultation in the account's currency (minor units are
  /// NOT used — an integer rupee amount keeps the UI simple).
  consultationFee           Int?
  verificationStatus        VerificationStatus @default(PENDING_VERIFICATION)
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability DoctorAvailability[]

  @@unique([medicalRegistrationNumber, medicalCouncil])
  @@index([verificationStatus])
  @@index([city, state])
  @@map("doctor_profiles")
}

/// Weekly consultation windows a doctor is available to patients.
model DoctorAvailability {
  id        String    @id @default(cuid())
  doctorId  String
  day       DayOfWeek
  isEnabled Boolean   @default(true)
  /// 24h "HH:mm" strings.
  startTime String    @default("09:00")
  endTime   String    @default("17:00")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  doctor DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, day])
  @@map("doctor_availability")
}

model PharmacyProfile {
  id                         String             @id @default(cuid())
  userId                     String             @unique
  pharmacyName               String
  ownerName                  String
  drugLicenseNumber          String?
  gstNumber                  String?
  pharmacyRegistrationNumber String?
  pharmacyType               PharmacyType
  address                    String
  city                       String
  state                      String
  pincode                    String
  contactNumber              String
  verificationStatus         VerificationStatus @default(PENDING_VERIFICATION)
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  user  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hours PharmacyOperatingHours[]

  @@index([verificationStatus])
  @@index([city, state])
  @@map("pharmacy_profiles")
}

model PharmacyOperatingHours {
  id         String    @id @default(cuid())
  pharmacyId String
  day        DayOfWeek
  isClosed   Boolean   @default(false)
  /// 24h "HH:mm" strings.
  openTime   String    @default("09:00")
  closeTime  String    @default("21:00")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  pharmacy PharmacyProfile @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@unique([pharmacyId, day])
  @@map("pharmacy_operating_hours")
}

// ---------------------------------------------------------------------------
// Documents (private storage — never publicly reachable)
// ---------------------------------------------------------------------------

model Document {
  id                 String         @id @default(cuid())
  /// Set once the registration is completed. Documents uploaded before the
  /// account exists are temporarily attached to a registration ticket.
  userId             String?
  registrationId     String?
  documentType       DocumentType
  fileName           String
  /// Opaque key inside the private storage bucket. Never a public URL.
  storageKey         String         @unique
  mimeType           String
  fileSize           Int
  verificationStatus DocumentStatus @default(PENDING)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, documentType])
  @@index([registrationId])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// Care delivery (appointments, prescriptions, messaging, records)
// ---------------------------------------------------------------------------

/// A consultation slot booked by a patient with a verified doctor.
///
/// `doctorProfileId` is kept alongside `doctorUserId` so booking works against
/// the profile the patient browsed, while authorization always uses the user id.
model Appointment {
  id              String            @id @default(cuid())
  patientUserId   String
  doctorUserId    String
  doctorProfileId String
  /// Calendar day of the visit, stored at UTC midnight.
  scheduledDate DateTime
  /// 24h "HH:mm" start / end of the slot within the doctor's availability.
  startTime   String
  endTime     String
  status      AppointmentStatus @default(REQUESTED)
  reason      String?
  /// Populated with a meeting URL/provider reference once confirmed.
  meetingUrl String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  patient       User           @relation("PatientAppointments", fields: [patientUserId], references: [id], onDelete: Cascade)
  doctor        User           @relation("DoctorAppointments", fields: [doctorUserId], references: [id], onDelete: Cascade)
  prescriptions Prescription[]
  signals       ConsultationSignal[]

  @@index([patientUserId, scheduledDate])
  @@index([doctorUserId, scheduledDate])
  @@index([doctorProfileId, scheduledDate])
  @@index([status])
  @@map("appointments")
}

/// A prescription written by a doctor for a patient, optionally linked to the
/// consultation it came out of.
model Prescription {
  id            String             @id @default(cuid())
  patientUserId String
  doctorUserId  String
  appointmentId String?
  diagnosis     String?
  notes         String?
  status        PrescriptionStatus @default(ACTIVE)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  patient     User              @relation("PatientPrescriptions", fields: [patientUserId], references: [id], onDelete: Cascade)
  doctor      User              @relation("DoctorPrescriptions", fields: [doctorUserId], references: [id], onDelete: Cascade)
  appointment Appointment?      @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  items       PrescriptionItem[]

  @@index([patientUserId, createdAt])
  @@index([doctorUserId, createdAt])
  @@map("prescriptions")
}

/// One medicine line on a prescription.
model PrescriptionItem {
  id             String @id @default(cuid())
  prescriptionId String
  medicineName   String
  dosage         String?
  frequency      String?
  duration       String?
  instructions   String?

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@map("prescription_items")
}

/// A 1:1 patient–doctor message thread. Exactly one row exists per pair, so a
/// patient can never see — or be added to — another patient's thread.
model Conversation {
  id            String   @id @default(cuid())
  patientUserId String
  doctorUserId  String
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  patient  User      @relation("PatientConversations", fields: [patientUserId], references: [id], onDelete: Cascade)
  doctor   User      @relation("DoctorConversations", fields: [doctorUserId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([patientUserId, doctorUserId])
  @@index([patientUserId, lastMessageAt])
  @@index([doctorUserId, lastMessageAt])
  @@map("conversations")
}

/// A single chat message inside a conversation.
model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderUserId   String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// One WebRTC signalling exchange inside a video room (offer / answer / ICE
/// candidate, or a join/leave marker). Rows are pruned when the call ends.
model ConsultationSignal {
  id            String   @id @default(cuid())
  appointmentId String
  senderUserId  String
  /// SDP / candidate JSON as a string, so the payload shape stays opaque here.
  payload       String
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
  @@map("consultation_signals")
}

/// A file or note a patient keeps in their own health record. A private-storage
/// document row may be attached; doctors the patient has an appointment with
/// can read it, nobody else can.
model MedicalRecord {
  id            String            @id @default(cuid())
  patientUserId String
  recordType    MedicalRecordType @default(OTHER)
  title         String
  description   String?
  /// Optional link to a row in documents (private storage key).
  documentId String?
  /// Calendar day the record refers to (report date, visit date, …).
  recordDate DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  patient User @relation(fields: [patientUserId], references: [id], onDelete: Cascade)

  @@index([patientUserId, recordDate])
  @@map("medical_records")
}

// ---------------------------------------------------------------------------
// Pharmacy commerce (inventory + orders)
// ---------------------------------------------------------------------------

/// A medicine a pharmacy stocks. Verified pharmacies manage their own rows;
/// patients search across every verified pharmacy's stock.
model MedicineInventory {
  id             String       @id @default(cuid())
  pharmacyUserId String
  name           String
  brand          String?
  strength       String?
  unit           MedicineUnit @default(TABLET)
  priceInPaise   Int
  stockQuantity  Int          @default(0)
  requiresRx     Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  pharmacy User        @relation(fields: [pharmacyUserId], references: [id], onDelete: Cascade)
  items    OrderItem[]

  @@index([pharmacyUserId, name])
  @@index([name])
  @@map("medicine_inventory")
}

/// A medicine order a patient placed with one pharmacy.
model PharmacyOrder {
  id              String      @id @default(cuid())
  patientUserId   String
  pharmacyUserId  String
  status          OrderStatus @default(PLACED)
  totalInPaise    Int         @default(0)
  deliveryAddress String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  patient  User        @relation("PatientOrders", fields: [patientUserId], references: [id], onDelete: Cascade)
  pharmacy User        @relation("PharmacyOrders", fields: [pharmacyUserId], references: [id], onDelete: Cascade)
  items    OrderItem[]

  @@index([patientUserId, createdAt])
  @@index([pharmacyUserId, createdAt])
  @@map("pharmacy_orders")
}

/// One medicine line on a pharmacy order. Pricing is snapshotted at order
/// time so later price edits never rewrite history.
model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  medicineId       String?
  medicineName     String
  quantity         Int
  /// Snapshot of MedicineInventory.priceInPaise at order time.
  unitPriceInPaise Int

  order    PharmacyOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medicine MedicineInventory? @relation(fields: [medicineId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}
